<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string title ? $"{title} · {Options.AppName}" : Options.AppName)</title>
    <script>document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';</script>
    <link rel="stylesheet" href="@(string.IsNullOrEmpty(Options.Stylesheet) ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" : Options.Stylesheet)">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
@* The "theme" class turns on the Polr.NET colours; a custom stylesheet replaces them. *@
<body class="d-flex flex-column min-vh-100 @(string.IsNullOrEmpty(Options.Stylesheet) ? "theme" : "")">
    <nav class="navbar navbar-expand-md bg-body border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="/">
                <span class="logo"><i class="bi bi-link-45deg"></i></span>
                @Options.AppName
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                </ul>
                <ul class="navbar-nav align-items-md-center gap-md-2">
                    @if (User.Username() is { } username)
                    {
                        <li class="nav-item"><a class="nav-link" href="/admin"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Logout">
                                <button class="nav-link" title="Signed in as @username"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/login">Sign in</a></li>
                        @if (Options.AllowSignup)
                        {
                            <li class="nav-item"><a class="btn btn-primary btn-sm px-3" href="/signup">Sign up</a></li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top bg-body small text-body-secondary py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year @Options.AppName</span>
            <span>Powered by <a href="/about">Polr.NET</a></span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
