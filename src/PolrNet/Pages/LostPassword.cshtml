@page "/lost_password"
@model LostPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="text-center mb-4">
            <span class="logo logo-lg"><i class="bi bi-key"></i></span>
            <h1 class="h4 mt-3 mb-1">Reset your password</h1>
            <p class="small text-body-secondary mb-0">Enter your account's email and we will send you a reset link.</p>
        </div>
        <form method="post" class="card card-body border-0 shadow-sm p-4">
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" required autofocus>
            </div>
            <button class="btn btn-primary w-100">Send reset link</button>
        </form>
    </div>
</div>
