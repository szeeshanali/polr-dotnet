@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Sign in</h1>
        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary w-100">Sign in</button>
        </form>
        <p class="mt-3 small text-center">
            @if (Options.AllowSignup)
            {
                <a href="/signup">Create an account</a>
            }
            @if (Options.AllowSignup && Options.PasswordRecovery)
            {
                <span class="text-body-secondary">·</span>
            }
            @if (Options.PasswordRecovery)
            {
                <a href="/lost_password">Forgot your password?</a>
            }
        </p>
    </div>
</div>
