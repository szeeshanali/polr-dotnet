@page
@model IndexModel

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-5 fw-semibold text-center my-4">@Options.AppName</h1>

        @if (Model.ShortUrl is not null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <p class="text-body-secondary mb-2">Your short link</p>
                    <div class="input-group input-group-lg mb-3">
                        <input id="short-url" class="form-control text-center" value="@Model.ShortUrl" readonly>
                        <button class="btn btn-outline-primary" type="button" data-copy="#short-url">Copy</button>
                    </div>
                    <div class="qr d-inline-block p-2 bg-white rounded" data-qr="@Model.ShortUrl"></div>
                </div>
            </div>
        }

        <form method="post" class="card card-body shadow-sm">
            <label asp-for="LongUrl" class="visually-hidden">Long URL</label>
            <input asp-for="LongUrl" type="url" class="form-control form-control-lg" placeholder="Paste a long URL" required autofocus>

            <details class="mt-3">
                <summary class="text-body-secondary">Link options</summary>
                <div class="mt-3">
                    <label asp-for="CustomEnding" class="form-label">Custom ending (optional)</label>
                    <div class="input-group">
                        <span class="input-group-text">@Options.BaseUrl/</span>
                        <input asp-for="CustomEnding" class="form-control" pattern="[A-Za-z0-9_\-]+" title="Letters, numbers, hyphens and underscores">
                        <button class="btn btn-outline-secondary" type="button" id="check-ending">Check</button>
                    </div>
                    <div id="ending-status" class="form-text"></div>

                    <div class="form-check mt-3">
                        <input asp-for="Secret" class="form-check-input">
                        <label asp-for="Secret" class="form-check-label">Secret link (only opens with an extra key in the URL)</label>
                    </div>
                </div>
            </details>

            <button class="btn btn-primary btn-lg mt-3">Shorten</button>
        </form>
    </div>
</div>

@section Scripts {
    @if (Model.ShortUrl is not null)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    }
}
