@page "/signup"
@model SignupModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Create an account</h1>
        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" pattern="[A-Za-z0-9_\-]+" title="Letters, numbers, hyphens and underscores" required autofocus>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" required>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" minlength="8" required>
            </div>
            @if (Options.Recaptcha.Enabled)
            {
                <div class="g-recaptcha mb-3" data-sitekey="@Options.Recaptcha.SiteKey"></div>
            }
            <button class="btn btn-primary w-100">Sign up</button>
        </form>
        <p class="mt-3 small text-center">Already have an account? <a href="/login">Sign in</a></p>
    </div>
</div>

@section Scripts {
    @if (Options.Recaptcha.Enabled)
    {
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }
}
