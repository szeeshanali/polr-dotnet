@page "/about-polr"
@{
    ViewData["Title"] = "About";
    var version = typeof(PolrOptions).Assembly.GetName().Version?.ToString(3);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">About @Options.AppName</h1>
        <p>
            @Options.AppName is a link shortener powered by <strong>Polr.NET @version</strong>,
            a free and open-source link shortener for .NET and MySQL.
        </p>
        <p>
            Polr.NET is released under the
            <a href="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html">GNU General Public License, version 2 or later</a>.
            Based on <a href="https://github.com/cydrobolt/polr">Polr</a> by Chaoyi Zha and contributors.
        </p>
        @if (User.Username() is not null)
        {
            <p>Developers can use the <a href="https://github.com/szeeshanali/polr-dotnet/blob/main/docs/API.md">Polr API</a> to shorten links from their own apps.</p>
        }
    </div>
</div>
