@page "/lost_password"
@model LostPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Reset your password</h1>
        <form method="post" class="card card-body shadow-sm">
            <p class="text-body-secondary">Enter your account's email and we will send you a reset link.</p>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" required autofocus>
            </div>
            <button class="btn btn-primary w-100">Send reset link</button>
        </form>
    </div>
</div>
