@page "/admin"
@model Polr.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var tabs = new List<(string Id, string Label)> { ("links", "My links") };
    if (Model.Me.IsAdmin)
    {
        tabs.Add(("all-links", "All links"));
        tabs.Add(("users", "Users"));
    }
    tabs.Add(("settings", "Settings"));
    tabs.Add(("api", "API"));
}

<h1 class="h3 mb-3">Hi, @Model.Me.Username</h1>

<ul class="nav nav-tabs mb-3">
    @foreach (var (id, label) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == id ? "active" : "")" href="?tab=@id">@label</a>
        </li>
    }
</ul>

@switch (Model.Tab)
{
    case "links":
    case "all-links":
        <partial name="_Links" />
        break;

    case "users":
        <partial name="_Users" />
        break;

    case "settings":
        <h2 class="h5">Change password</h2>
        <form method="post" asp-page-handler="ChangePassword" asp-all-route-data="Model.State" class="card card-body shadow-sm" style="max-width: 28rem">
            <div class="mb-3">
                <label for="currentPassword" class="form-label">Current password</label>
                <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required>
            </div>
            <div class="mb-3">
                <label for="newPassword" class="form-label">New password</label>
                <input id="newPassword" name="newPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" required>
            </div>
            <button class="btn btn-primary">Change password</button>
        </form>
        break;

    case "api":
        <h2 class="h5">API access</h2>
        @if (Model.Me.ApiActive)
        {
            @if (Model.Me.ApiKey is { Length: > 0 } apiKey)
            {
                <div class="input-group mb-3" style="max-width: 32rem">
                    <input id="api-key" class="form-control font-monospace" value="@apiKey" readonly aria-label="Your API key">
                    <button class="btn btn-outline-primary" type="button" data-copy="#api-key">Copy</button>
                </div>
            }
            <p>Quota: @(Model.Me.ApiQuota < 0 ? "unlimited" : $"{Model.Me.ApiQuota} links per minute").</p>
            <form method="post" asp-page-handler="NewApiKey" asp-all-route-data="Model.State" class="mb-4">
                <input type="hidden" name="id" value="@Model.Me.Id">
                <button class="btn btn-outline-secondary">@(Model.Me.ApiKey is { Length: > 0 } ? "Generate a new key" : "Generate a key")</button>
            </form>
            <p class="mb-1">Example:</p>
            <pre class="bg-body-tertiary p-3 rounded small"><code>curl "@Options.BaseUrl/api/v2/action/shorten?key=YOUR_KEY&url=https://example.com"</code></pre>
            <p>See the <a href="https://github.com/szeeshanali/polr-dotnet/blob/main/docs/API.md">API documentation</a> for all endpoints.</p>
        }
        else
        {
            <p class="text-body-secondary">API access is not turned on for your account. Ask an administrator to turn it on.</p>
        }
        break;
}
