@page "/reset_password/{username}/{key}"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Choose a new password</h1>
        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New password</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" required autofocus>
            </div>
            <button class="btn btn-primary w-100">Save password</button>
        </form>
    </div>
</div>
